# SolarGrid AI local environment
# Put real private API keys only on your own machine. Do not commit/share this file.

SECRET_KEY=solargrid-local-secret-key
SQLALCHEMY_DATABASE_URI=sqlite:///solargrid.db

FLASK_DEBUG=false
HOST=127.0.0.1
PORT=5000
SQLALCHEMY_TRACK_MODIFICATIONS=false
SQLALCHEMY_ECHO=false

# Optional backend LLM agent endpoint. The v2.5 web UI does not expose an AI Assistant page.
GROQ_API_KEY=
LLM_MODEL_NAME=openai/gpt-oss-20b

# Optional EIA benchmark integration (never Jordan telemetry).
# If empty, the source is reported as NOT_CONFIGURED; no value is fabricated.
EIA_API_KEY=
EIA_BASE_URL=https://api.eia.gov/v2/

# Public APIs; no API keys required.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/

SOLARGRID_RAG_PREWARM=true
SOLARGRID_RAG_ALLOW_MODEL_DOWNLOAD=false

# Event-driven monitor. Human Approval + Safety remain mandatory before Tool 13.
SOLARGRID_AUTOMATION_ENABLED=true

# Leave empty to use config/simulation_v1.json automatically.
SOLARGRID_SIMULATION_CONFIG=
